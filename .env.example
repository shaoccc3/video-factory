# 複製為 .env 後填值；.env 不得提交。只列變量名，說明見 docs/runbook.md。
# 區域與模型
ARK_REGION=
ARK_API_KEY=
PROVIDER_MODE=
ARK_STRIP_AUTH_HEADER=
# 語音合成（豆包語音）
TTS_APP_ID=
TTS_TOKEN=
# 數據庫與隊列（DATABASE_URL、VALKEY_URL 在 Docker 部署時由 compose 組合，不用填）
POSTGRES_PASSWORD=
DATABASE_URL=
VALKEY_URL=
# 對象存儲（S3 相容；S3_PUBLIC_ENDPOINT_URL 是給 Seedance 拉素材的公網地址）
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 登入會話（至少 32 位隨機字串）；HTTPS 部署時 COOKIE_SECURE=true
SECRET_KEY=
COOKIE_SECURE=
# 選填的運維參數（留空用預設值；DOWNLOAD_ALLOWED_HOSTS 是 JSON 陣列，會取代預設清單）
DOWNLOAD_ALLOWED_HOSTS=
DOWNLOAD_MAX_BYTES=
SEEDANCE_TOTAL_TIMEOUT_S=
PRESIGN_EXPIRES_S=
# 其他
WEB_PORT=
LOG_LEVEL=
LIVE_BUDGET_CNY=
